<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<ScrollPane xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="de.mealdeal.ui.controller.HomeController"
            fitToWidth="true" hbarPolicy="NEVER" styleClass="content-scroll">
    <content>
        <StackPane alignment="TOP_CENTER" styleClass="page-shell">
            <VBox maxWidth="1080.0" spacing="30.0" styleClass="page-container">
                <VBox spacing="6.0" styleClass="page-header">
                    <Label text="Was möchtest du heute essen?" wrapText="true" styleClass="page-title"/>
                    <Label text="Finde eine Idee, plane den Tag oder behalte deine Woche im Blick."
                           wrapText="true" styleClass="page-subtitle"/>
                </VBox>

                <VBox maxWidth="1.7976931348623157E308" spacing="16.0"
                      styleClass="card, search-card">
                    <Label text="Was möchtest du essen?" wrapText="true" styleClass="card-title"/>
                    <Label text="Suche nach passenden Gerichten anhand deiner Zutaten oder deines Geschmacks."
                           wrapText="true" styleClass="card-text"/>
                    <Button text="Gericht finden" onAction="#openSearch"
                            styleClass="primary-button"/>
                </VBox>

                <VBox spacing="12.0" styleClass="dashboard-section">
                    <Label text="Heute" styleClass="section-title"/>
                    <VBox maxWidth="1.7976931348623157E308" spacing="12.0" styleClass="card, wide-card">
                        <Label text="Noch nichts geplant" styleClass="card-title"/>
                        <Label text="Lege im Wochenplan fest, welches Gericht heute auf den Tisch kommt."
                               wrapText="true" styleClass="card-text"/>
                        <Button text="Zum Wochenplan" onAction="#openWeekPlan"
                                styleClass="primary-button"/>
                    </VBox>
                </VBox>

                <VBox spacing="12.0" styleClass="dashboard-section">
                    <Label text="Wochenplan" styleClass="section-title"/>
                    <VBox maxWidth="1.7976931348623157E308" spacing="12.0" styleClass="card, wide-card">
                        <Label text="Plane deine Woche von Montag bis Sonntag." wrapText="true"
                               styleClass="card-title"/>
                        <Label text="Die geplanten Gerichte werden hier in einer späteren Phase sichtbar."
                               wrapText="true" styleClass="card-text"/>
                        <Button text="Wochenplan öffnen" onAction="#openWeekPlan"
                                styleClass="primary-button"/>
                    </VBox>
                </VBox>

                <VBox spacing="12.0" styleClass="dashboard-section, compact-section">
                    <Label text="Meine Gerichte" styleClass="section-title"/>
                    <VBox maxWidth="1.7976931348623157E308" spacing="14.0" styleClass="card, compact-card">
                        <Label text="Verwalte deine gespeicherten Gerichte." wrapText="true"
                               styleClass="card-text"/>
                        <HBox spacing="12.0" styleClass="button-row">
                            <Button text="Gerichte ansehen" onAction="#openRecipes"
                                    styleClass="primary-button"/>
                            <Button text="Neues Gericht hinzufügen" onAction="#openCreateRecipe"
                                    styleClass="secondary-button"/>
                        </HBox>
                    </VBox>
                </VBox>
            </VBox>
        </StackPane>
    </content>
</ScrollPane>
