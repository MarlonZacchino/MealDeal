<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TitledPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<ScrollPane xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="de.mealdeal.ui.controller.HomeController"
            fitToWidth="true" hbarPolicy="NEVER" styleClass="content-scroll">
    <content>
        <StackPane alignment="TOP_CENTER" styleClass="page-shell">
            <VBox maxWidth="1.7976931348623157E308" spacing="8.0" styleClass="page-container">
                <VBox maxWidth="1.7976931348623157E308"
                      styleClass="content-card, home-card">
                    <HBox alignment="CENTER_LEFT" styleClass="content-card-header">
                        <Label text="Gericht finden" wrapText="true"
                               styleClass="content-card-header-title"/>
                    </HBox>
                    <VBox spacing="16.0" styleClass="content-card-body">
                        <Label text="Suche nach passenden Gerichten anhand deiner Zutaten oder deines Geschmacks."
                               wrapText="true" styleClass="card-text"/>
                        <Button text="Gericht finden" onAction="#openSearch"
                                styleClass="primary-button"/>
                    </VBox>
                </VBox>

                <VBox maxWidth="1.7976931348623157E308"
                      styleClass="content-card, home-card">
                    <HBox alignment="CENTER_LEFT" styleClass="content-card-header">
                        <Label text="Meine Gerichte" styleClass="content-card-header-title"/>
                    </HBox>
                    <VBox spacing="14.0" styleClass="content-card-body">
                        <Label text="Verwalte deine gespeicherten Gerichte." wrapText="true"
                               styleClass="card-text"/>
                        <HBox spacing="12.0" styleClass="button-row">
                            <Button text="Gerichte ansehen" onAction="#openRecipes"
                                    styleClass="primary-button"/>
                            <Button text="Neues Gericht hinzufügen" onAction="#openCreateRecipe"
                                    styleClass="secondary-button"/>
                        </HBox>
                    </VBox>
                </VBox>

                <VBox maxWidth="1.7976931348623157E308"
                      styleClass="content-card, home-card">
                    <HBox alignment="CENTER_LEFT" styleClass="content-card-header">
                        <Label text="Heute" styleClass="content-card-header-title"/>
                    </HBox>
                    <VBox spacing="12.0" styleClass="content-card-body">
                        <VBox fx:id="todayPlanContent" maxWidth="1.7976931348623157E308"
                              spacing="10.0" styleClass="home-plan-content"/>
                        <VBox fx:id="todayEmptyState" alignment="CENTER_LEFT" spacing="8.0"
                              managed="false" visible="false">
                            <Label text="Noch nichts geplant" styleClass="card-title"/>
                            <Label text="Lege im Wochenplan fest, welche Gerichte heute auf den Tisch kommen."
                                   wrapText="true" styleClass="card-text"/>
                        </VBox>
                        <VBox fx:id="todayErrorState" alignment="CENTER_LEFT" spacing="8.0"
                              managed="false" visible="false">
                            <Label text="Der heutige Plan konnte nicht geladen werden."
                                   wrapText="true" styleClass="card-title"/>
                        </VBox>
                        <Button text="Zum Wochenplan" onAction="#openWeekPlan"
                                styleClass="primary-button"/>
                    </VBox>
                </VBox>

                <TitledPane text="Wochenplan Übersicht" collapsible="true" expanded="false"
                            maxWidth="1.7976931348623157E308"
                            styleClass="expandable-card, home-week-pane">
                    <content>
                        <VBox maxWidth="1.7976931348623157E308" spacing="12.0"
                              styleClass="home-week-content">
                            <VBox fx:id="weekOverviewContainer"
                                  maxWidth="1.7976931348623157E308"
                                  spacing="8.0" styleClass="home-week-overview"/>
                            <VBox fx:id="weekErrorState" alignment="CENTER_LEFT" spacing="8.0"
                                  managed="false" visible="false">
                                <Label text="Die Wochenübersicht konnte nicht geladen werden."
                                       wrapText="true" styleClass="card-title"/>
                            </VBox>
                            <Button text="Wochenplan öffnen" onAction="#openWeekPlan"
                                    styleClass="primary-button"/>
                        </VBox>
                    </content>
                </TitledPane>
            </VBox>
        </StackPane>
    </content>
</ScrollPane>
