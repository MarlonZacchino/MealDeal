<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.VBox?>

<ScrollPane xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="de.mealdeal.ui.controller.HomeController"
            fitToWidth="true" hbarPolicy="NEVER" styleClass="content-scroll">
    <content>
        <VBox spacing="12.0" styleClass="page">
            <padding>
                <Insets top="44.0" right="44.0" bottom="44.0" left="44.0"/>
            </padding>
            <Label text="Was möchtest du machen?" wrapText="true" styleClass="page-title"/>
            <Label text="Wähle einen Bereich aus und starte deine Essensplanung."
                   wrapText="true" styleClass="page-subtitle"/>
            <FlowPane hgap="20.0" vgap="20.0" prefWrapLength="820.0" styleClass="card-grid">
                <VBox prefWidth="260.0" minHeight="250.0" spacing="14.0" styleClass="action-card">
                    <Label text="Was soll ich essen?" wrapText="true" styleClass="card-title"/>
                    <Label text="Finde Gerichte passend zu deinen Zutaten oder deinem Geschmack."
                           wrapText="true" styleClass="card-text"/>
                    <Button text="Nach Zutaten suchen" maxWidth="1.7976931348623157E308"
                            onAction="#openSearch" styleClass="primary-button"/>
                    <Button text="Nach Geschmack suchen" maxWidth="1.7976931348623157E308"
                            onAction="#openSearch" styleClass="secondary-button"/>
                </VBox>
                <VBox prefWidth="260.0" minHeight="250.0" spacing="14.0" styleClass="action-card">
                    <Label text="Meine Gerichte" wrapText="true" styleClass="card-title"/>
                    <Label text="Behalte deine gespeicherten Gerichte im Blick."
                           wrapText="true" styleClass="card-text"/>
                    <Button text="Gerichte ansehen" maxWidth="1.7976931348623157E308"
                            onAction="#openRecipes" styleClass="primary-button"/>
                    <Button text="Neues Gericht hinzufügen" maxWidth="1.7976931348623157E308"
                            onAction="#openRecipes" styleClass="secondary-button"/>
                </VBox>
                <VBox prefWidth="260.0" minHeight="250.0" spacing="14.0" styleClass="action-card">
                    <Label text="Planung" wrapText="true" styleClass="card-title"/>
                    <Label text="Plane die Woche und bereite deinen Einkauf vor."
                           wrapText="true" styleClass="card-text"/>
                    <Button text="Wochenplan" maxWidth="1.7976931348623157E308"
                            onAction="#openWeekPlan" styleClass="primary-button"/>
                    <Button text="Einkaufsliste" maxWidth="1.7976931348623157E308"
                            onAction="#openShopping" styleClass="secondary-button"/>
                </VBox>
            </FlowPane>
        </VBox>
    </content>
</ScrollPane>
