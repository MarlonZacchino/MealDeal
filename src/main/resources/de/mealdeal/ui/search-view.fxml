<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.TitledPane?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<ScrollPane xmlns:fx="http://javafx.com/fxml/1" fitToWidth="true" hbarPolicy="NEVER"
            styleClass="content-scroll"
            fx:controller="de.mealdeal.ui.controller.IngredientSearchController">
    <content>
        <StackPane alignment="TOP_CENTER" styleClass="page-shell">
            <VBox maxWidth="1.7976931348623157E308" spacing="28.0" styleClass="page-container">
                <fx:define>
                    <ToggleGroup fx:id="tasteModeGroup"/>
                </fx:define>
                <VBox spacing="6.0" styleClass="page-header">
                    <Label text="Was essen?" styleClass="page-title"/>
                    <Label text="Finde passende Gerichte nach Zutaten oder Geschmack."
                           wrapText="true" styleClass="page-subtitle"/>
                </VBox>

                <Label fx:id="searchMessage" managed="false" visible="false"
                       wrapText="true" styleClass="form-message"/>

                <TitledPane fx:id="ingredientSelectionPane" text="Zutaten auswählen"
                            animated="true" collapsible="true" expanded="false"
                            maxWidth="1.7976931348623157E308"
                             styleClass="expandable-card, search-options-pane, search-selection-pane">
                    <content>
                        <VBox maxWidth="1.7976931348623157E308" spacing="18.0"
                              styleClass="search-selection-content">
                            <HBox alignment="CENTER_LEFT" spacing="12.0">
                                <Label text="Wähle mindestens eine und höchstens zehn Zutaten."
                                       wrapText="true" styleClass="card-text"
                                       HBox.hgrow="ALWAYS"/>
                                <Label fx:id="selectionCountLabel" styleClass="selection-count"/>
                            </HBox>
                            <TextField fx:id="ingredientFilterField"
                                       promptText="Zutaten durchsuchen …"/>
                            <VBox fx:id="availableIngredientsContainer" spacing="10.0"/>
                            <VBox spacing="10.0" styleClass="sub-card, selected-ingredients-box">
                                <Label text="Deine Auswahl" styleClass="form-label"/>
                                <FlowPane fx:id="selectedIngredientsContainer" hgap="10.0" vgap="10.0"/>
                            </VBox>
                        </VBox>
                    </content>
                </TitledPane>

                <TitledPane fx:id="tasteSelectionPane" text="Geschmacksrichtungen auswählen"
                            animated="true" collapsible="true" expanded="false"
                            maxWidth="1.7976931348623157E308"
                             styleClass="expandable-card, search-options-pane, search-selection-pane">
                    <content>
                        <VBox maxWidth="1.7976931348623157E308" spacing="18.0"
                              styleClass="search-selection-content">
                            <HBox alignment="CENTER_LEFT" spacing="12.0">
                            <Label text="Wähle eine oder mehrere passende Geschmacksrichtungen."
                                       wrapText="true" styleClass="card-text"
                                       HBox.hgrow="ALWAYS"/>
                                <Label fx:id="tasteSelectionCountLabel" styleClass="selection-count"/>
                            </HBox>
                            <TextField fx:id="tasteFilterField"
                                       promptText="Geschmacksrichtungen durchsuchen …"/>
                            <FlowPane fx:id="availableTastesContainer" hgap="10.0" vgap="10.0"/>
                            <VBox spacing="10.0" styleClass="sub-card, selected-ingredients-box">
                                <Label text="Deine Auswahl" styleClass="form-label"/>
                                <FlowPane fx:id="selectedTastesContainer" hgap="10.0" vgap="10.0"/>
                            </VBox>
                        </VBox>
                    </content>
                </TitledPane>

                <TitledPane fx:id="searchOptionsPane" text="Filter &amp; Suchoptionen"
                            animated="true" collapsible="true" expanded="false"
                            maxWidth="1.7976931348623157E308"
                             styleClass="expandable-card, search-options-pane">
                    <content>
                        <VBox spacing="12.0" styleClass="search-options-content">
                            <Label text="Geschmacksfilter" styleClass="form-label"/>
                            <Label text="Diese Einstellung gilt nur für ausgewählte Geschmacksrichtungen. Die Zutatenbewertung bleibt PERFECT / GOOD / PARTIAL."
                                   wrapText="true" styleClass="mode-description"/>
                            <HBox spacing="10.0">
                                <VBox minWidth="0.0" spacing="5.0" HBox.hgrow="ALWAYS"
                                      styleClass="sub-card, taste-mode-card">
                                    <RadioButton fx:id="tasteAndMode" text="Alle (AND)"
                                                 toggleGroup="$tasteModeGroup"/>
                                    <Label text="Das Gericht enthält jede ausgewählte Geschmacksrichtung."
                                           wrapText="true" styleClass="mode-description"/>
                                </VBox>
                                <VBox minWidth="0.0" spacing="5.0" HBox.hgrow="ALWAYS"
                                      styleClass="sub-card, taste-mode-card">
                                    <RadioButton fx:id="tasteOrMode" text="Mindestens eine (OR)"
                                                 toggleGroup="$tasteModeGroup"/>
                                    <Label text="Das Gericht enthält mindestens eine der ausgewählten Richtungen."
                                           wrapText="true" styleClass="mode-description"/>
                                </VBox>
                                <VBox minWidth="0.0" spacing="5.0" HBox.hgrow="ALWAYS"
                                      styleClass="sub-card, taste-mode-card">
                                    <RadioButton fx:id="tasteRankingMode"
                                                 text="Beste Treffer (RANKING)"
                                                 selected="true" toggleGroup="$tasteModeGroup"/>
                                    <Label text="Alle Treffer werden nach ihrer Übereinstimmung sortiert."
                                           wrapText="true" styleClass="mode-description"/>
                                </VBox>
                            </HBox>
                        </VBox>
                    </content>
                </TitledPane>

                <HBox alignment="CENTER_RIGHT" spacing="12.0">
                    <Button text="Gericht finden" onAction="#search"
                            styleClass="primary-button"/>
                    <Button text="Alle Filter zurücksetzen" onAction="#resetFilters"
                            styleClass="secondary-button, search-reset-button"/>
                </HBox>

                <VBox spacing="14.0">
                    <Label text="Ergebnisse" styleClass="section-title"/>
                    <VBox fx:id="resultsContainer" alignment="TOP_LEFT" VBox.vgrow="NEVER"
                          managed="false" visible="false" spacing="12.0"/>

                    <VBox fx:id="initialState" alignment="CENTER" spacing="8.0"
                           styleClass="content-card, search-state-card">
                        <Label text="Bereit für deine Suche" styleClass="card-title"/>
                        <Label text="Wähle Zutaten, Geschmacksrichtungen oder beides und starte die Suche."
                               wrapText="true" styleClass="card-text"/>
                    </VBox>

                    <VBox fx:id="emptyState" alignment="CENTER" spacing="8.0"
                          managed="false" visible="false"
                           styleClass="content-card, search-state-card">
                        <Label text="Keine passenden Gerichte gefunden" styleClass="card-title"/>
                        <Label text="Verändere deine Auswahl oder probiere einen anderen Suchmodus."
                               wrapText="true" styleClass="card-text"/>
                    </VBox>

                    <VBox fx:id="errorState" alignment="CENTER" spacing="8.0"
                          managed="false" visible="false"
                           styleClass="content-card, search-state-card">
                        <Label text="Die Suche ist gerade nicht verfügbar" styleClass="card-title"/>
                        <Label text="Bitte versuche es erneut."
                               wrapText="true" styleClass="card-text"/>
                    </VBox>
                </VBox>
            </VBox>
        </StackPane>
    </content>
</ScrollPane>
