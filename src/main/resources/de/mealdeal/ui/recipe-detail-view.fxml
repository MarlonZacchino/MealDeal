<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<ScrollPane xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="de.mealdeal.ui.controller.RecipeDetailController"
            fitToWidth="true" hbarPolicy="NEVER" styleClass="content-scroll">
    <content>
        <StackPane alignment="TOP_CENTER" styleClass="page-shell">
            <VBox maxWidth="1080.0" spacing="24.0" styleClass="page-container">
                <HBox alignment="CENTER_LEFT" spacing="18.0" styleClass="page-header">
                    <Button text="Zurück" onAction="#backToRecipes" styleClass="secondary-button"/>
                    <VBox spacing="5.0">
                        <Label fx:id="nameLabel" styleClass="page-title"/>
                        <Label fx:id="standardServingLabel" styleClass="page-subtitle"/>
                    </VBox>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button text="Bearbeiten" onAction="#editRecipe" styleClass="primary-button"/>
                </HBox>

                <HBox alignment="CENTER_LEFT" spacing="18.0" styleClass="card, compact-card">
                    <VBox spacing="4.0">
                        <Label text="Personenanzahl" styleClass="section-title"/>
                        <Label text="Die Zutatenmengen passen sich automatisch an."
                               wrapText="true" styleClass="card-text"/>
                    </VBox>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Spinner fx:id="servingSpinner" editable="false" prefWidth="110.0"
                             styleClass="serving-spinner"/>
                </HBox>

                <VBox spacing="10.0" styleClass="card, detail-section-card">
                    <Label text="Geschmacksrichtungen" styleClass="section-title"/>
                    <Label fx:id="tastesLabel" wrapText="true" styleClass="detail-row-text"/>
                </VBox>

                <VBox spacing="14.0" styleClass="card, detail-section-card">
                    <Label text="Zutaten" styleClass="section-title"/>
                    <VBox fx:id="ingredientsContainer" spacing="8.0"/>
                </VBox>

                <VBox spacing="14.0" styleClass="card, detail-section-card">
                    <Label text="Zubereitung" styleClass="section-title"/>
                    <VBox fx:id="stepsContainer" spacing="8.0"/>
                </VBox>
            </VBox>
        </StackPane>
    </content>
</ScrollPane>
