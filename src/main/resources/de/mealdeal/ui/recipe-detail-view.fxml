<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<ScrollPane xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="de.mealdeal.ui.controller.RecipeDetailController"
            fitToWidth="true" hbarPolicy="NEVER" styleClass="content-scroll">
    <content>
        <StackPane alignment="TOP_CENTER" styleClass="page-shell">
            <VBox maxWidth="1.7976931348623157E308" spacing="22.0"
                  styleClass="page-container, page-container-detail">
                <HBox alignment="CENTER_LEFT" spacing="18.0"
                      styleClass="page-header, recipe-detail-header">
                    <VBox spacing="6.0" styleClass="recipe-detail-title-block">
                        <Label fx:id="nameLabel" wrapText="true" styleClass="page-title"/>
                        <Label fx:id="dishTypeLabel" styleClass="recipe-type-badge"/>
                    </VBox>
                    <Region HBox.hgrow="ALWAYS"/>
                    <FlowPane alignment="CENTER_RIGHT" hgap="10.0" vgap="10.0"
                              styleClass="recipe-detail-actions">
                        <Button text="Zurück" onAction="#backToRecipes"
                                styleClass="secondary-button"/>
                        <Button text="Bearbeiten" onAction="#editRecipe"
                                styleClass="primary-button"/>
                        <Button text="Löschen" onAction="#deleteRecipe"
                                styleClass="danger-button"/>
                    </FlowPane>
                </HBox>

                <GridPane fx:id="detailMetaGrid" hgap="18.0" vgap="18.0"
                          styleClass="recipe-detail-meta-grid">
                    <columnConstraints>
                        <ColumnConstraints percentWidth="45.0"/>
                        <ColumnConstraints percentWidth="55.0"/>
                    </columnConstraints>
                    <VBox fx:id="servingSection" spacing="9.0" GridPane.columnIndex="0">
                        <Label text="Personen" styleClass="section-title"/>
                        <HBox alignment="CENTER_LEFT" spacing="12.0">
                            <Spinner fx:id="servingSpinner" editable="false" prefWidth="110.0"
                                     styleClass="serving-spinner"/>
                            <Label fx:id="standardServingLabel" styleClass="card-text"/>
                        </HBox>
                    </VBox>
                    <VBox fx:id="tasteSection" spacing="9.0" GridPane.columnIndex="1">
                        <Label text="Geschmacksrichtungen" styleClass="section-title"/>
                        <FlowPane fx:id="tastesContainer" hgap="8.0" vgap="8.0"
                                  styleClass="detail-tastes"/>
                    </VBox>
                </GridPane>

                <GridPane fx:id="detailSectionsGrid" hgap="18.0" vgap="18.0"
                          styleClass="recipe-detail-grid">
                    <columnConstraints>
                        <ColumnConstraints percentWidth="45.0"/>
                        <ColumnConstraints percentWidth="55.0"/>
                    </columnConstraints>
                    <VBox fx:id="timeSection" spacing="10.0" GridPane.columnIndex="0"
                          GridPane.rowIndex="0"
                          styleClass="content-card, detail-section-card">
                        <Label text="Zeitangaben" styleClass="section-title"/>
                        <GridPane fx:id="detailTimeGrid" hgap="8.0" vgap="8.0"
                                  styleClass="detail-time-grid">
                            <columnConstraints>
                                <ColumnConstraints percentWidth="50.0"/>
                                <ColumnConstraints percentWidth="50.0"/>
                            </columnConstraints>
                            <HBox fx:id="preparationTimeBlock" alignment="CENTER_LEFT"
                                  spacing="12.0" GridPane.columnIndex="0" GridPane.rowIndex="0"
                                  styleClass="detail-item-block, detail-time-row">
                                <Label text="Vorbereitung" styleClass="detail-time-name"/>
                                <Region HBox.hgrow="ALWAYS"/>
                                <Label fx:id="preparationTimeValue" styleClass="detail-time-value"/>
                            </HBox>
                            <HBox fx:id="cookingTimeBlock" alignment="CENTER_LEFT" spacing="12.0"
                                  GridPane.columnIndex="1" GridPane.rowIndex="0"
                                  styleClass="detail-item-block, detail-time-row">
                                <Label text="Kochen" styleClass="detail-time-name"/>
                                <Region HBox.hgrow="ALWAYS"/>
                                <Label fx:id="cookingTimeValue" styleClass="detail-time-value"/>
                            </HBox>
                            <HBox fx:id="bakingTimeBlock" alignment="CENTER_LEFT" spacing="12.0"
                                  GridPane.columnIndex="0" GridPane.rowIndex="1"
                                  styleClass="detail-item-block, detail-time-row">
                                <Label text="Backen" styleClass="detail-time-name"/>
                                <Region HBox.hgrow="ALWAYS"/>
                                <Label fx:id="bakingTimeValue" styleClass="detail-time-value"/>
                            </HBox>
                            <HBox fx:id="restingTimeBlock" alignment="CENTER_LEFT" spacing="12.0"
                                  GridPane.columnIndex="1" GridPane.rowIndex="1"
                                  styleClass="detail-item-block, detail-time-row">
                                <Label text="Ruhezeit" styleClass="detail-time-name"/>
                                <Region HBox.hgrow="ALWAYS"/>
                                <Label fx:id="restingTimeValue" styleClass="detail-time-value"/>
                            </HBox>
                            <HBox fx:id="totalTimeBlock" alignment="CENTER_LEFT" spacing="12.0"
                                  GridPane.columnIndex="0" GridPane.rowIndex="2"
                                  GridPane.columnSpan="2"
                                  styleClass="detail-item-block, detail-time-row">
                                <Label text="Gesamt" styleClass="detail-time-name"/>
                                <Region HBox.hgrow="ALWAYS"/>
                                <Label fx:id="totalTimeValue" styleClass="detail-time-value"/>
                            </HBox>
                        </GridPane>
                    </VBox>

                    <VBox fx:id="nutritionSection" spacing="10.0" managed="false" visible="false"
                          GridPane.columnIndex="1" GridPane.rowIndex="0"
                          styleClass="content-card, detail-section-card">
                        <Label text="Nährwerte pro Portion" styleClass="section-title"/>
                        <GridPane fx:id="nutritionContainer" hgap="10.0" vgap="10.0"
                                  styleClass="detail-nutrition-grid"/>
                    </VBox>

                    <VBox fx:id="ingredientsSection" spacing="12.0" GridPane.columnIndex="0"
                          GridPane.rowIndex="1"
                          styleClass="content-card, detail-section-card">
                        <Label text="Zutaten" styleClass="section-title"/>
                        <VBox fx:id="ingredientsContainer" spacing="2.0"/>
                    </VBox>

                    <VBox fx:id="stepsSection" spacing="12.0" GridPane.columnIndex="1"
                          GridPane.rowIndex="1"
                          styleClass="content-card, detail-section-card">
                        <Label text="Zubereitung" styleClass="section-title"/>
                        <Label fx:id="emptyStepsLabel" text="Noch keine Zubereitung hinterlegt."
                               managed="false" visible="false" styleClass="card-text"/>
                        <VBox fx:id="stepsContainer" spacing="4.0"/>
                    </VBox>
                </GridPane>
            </VBox>
        </StackPane>
    </content>
</ScrollPane>
