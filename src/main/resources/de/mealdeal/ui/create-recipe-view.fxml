<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<ScrollPane xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="de.mealdeal.ui.controller.CreateRecipeController"
            fitToWidth="true" hbarPolicy="NEVER" styleClass="content-scroll">
    <content>
        <StackPane alignment="TOP_CENTER" styleClass="page-shell">
            <VBox maxWidth="1.7976931348623157E308" spacing="24.0" styleClass="page-container">
                <VBox spacing="6.0" styleClass="page-header">
                    <Label fx:id="titleLabel" text="Neues Gericht" styleClass="page-title"/>
                    <Label fx:id="subtitleLabel" text="Lege die Grunddaten, Zutaten, Geschmacksrichtungen und Zubereitung fest."
                           wrapText="true" styleClass="page-subtitle"/>
                </VBox>

                <Label fx:id="formMessage" managed="false" visible="false"
                       wrapText="true" styleClass="form-message"/>

                <VBox spacing="18.0" styleClass="content-card, form-section-card">
                    <Label text="Allgemein" styleClass="card-title"/>
                    <HBox spacing="18.0">
                        <VBox spacing="7.0" HBox.hgrow="ALWAYS" styleClass="form-field">
                            <Label text="Name" styleClass="form-label"/>
                            <TextField fx:id="nameField" promptText="z. B. Gemüsepfanne"
                                       maxWidth="1.7976931348623157E308"/>
                        </VBox>
                        <VBox spacing="7.0" styleClass="form-field, serving-field">
                            <Label text="Standard-Personenanzahl" styleClass="form-label"/>
                            <TextField fx:id="servingCountField" promptText="2"
                                       prefColumnCount="8"/>
                        </VBox>
                        <VBox spacing="7.0" styleClass="form-field, dish-type-field">
                            <Label text="Gerichtstyp" styleClass="form-label"/>
                            <ComboBox fx:id="dishTypeBox" prefWidth="190.0"/>
                        </VBox>
                    </HBox>
                    <VBox spacing="7.0">
                        <Label text="Zeitangaben (optional)" styleClass="form-label"/>
                        <FlowPane hgap="18.0" vgap="14.0" styleClass="recipe-time-fields">
                            <VBox spacing="6.0" styleClass="form-field, recipe-time-field">
                                <Label text="Vorbereitungszeit" styleClass="form-label"/>
                                <HBox spacing="8.0">
                                    <TextField fx:id="preparationTimeField" promptText="z. B. 20"
                                               maxWidth="1.7976931348623157E308"
                                               HBox.hgrow="ALWAYS"/>
                                    <ComboBox fx:id="preparationTimeUnitBox"
                                              styleClass="recipe-time-unit"/>
                                </HBox>
                            </VBox>
                            <VBox spacing="6.0" styleClass="form-field, recipe-time-field">
                                <Label text="Kochzeit" styleClass="form-label"/>
                                <HBox spacing="8.0">
                                    <TextField fx:id="cookingTimeField" promptText="z. B. 45"
                                               maxWidth="1.7976931348623157E308"
                                               HBox.hgrow="ALWAYS"/>
                                    <ComboBox fx:id="cookingTimeUnitBox"
                                              styleClass="recipe-time-unit"/>
                                </HBox>
                            </VBox>
                            <VBox spacing="6.0" styleClass="form-field, recipe-time-field">
                                <Label text="Backzeit" styleClass="form-label"/>
                                <HBox spacing="8.0">
                                    <TextField fx:id="bakingTimeField" promptText="z. B. 1"
                                               maxWidth="1.7976931348623157E308"
                                               HBox.hgrow="ALWAYS"/>
                                    <ComboBox fx:id="bakingTimeUnitBox"
                                              styleClass="recipe-time-unit"/>
                                </HBox>
                            </VBox>
                            <VBox spacing="6.0" styleClass="form-field, recipe-time-field">
                                <Label text="Ruhezeit" styleClass="form-label"/>
                                <HBox spacing="8.0">
                                    <TextField fx:id="restingTimeField" promptText="z. B. 30"
                                               maxWidth="1.7976931348623157E308"
                                               HBox.hgrow="ALWAYS"/>
                                    <ComboBox fx:id="restingTimeUnitBox"
                                              styleClass="recipe-time-unit"/>
                                </HBox>
                            </VBox>
                        </FlowPane>
                    </VBox>
                </VBox>

                <VBox spacing="16.0" styleClass="content-card, form-section-card">
                    <VBox spacing="4.0">
                        <Label text="Zutaten" styleClass="card-title"/>
                        <Label text="Pro Zutat kannst du Alternativen mit eigener Menge und Einheit ergänzen."
                               wrapText="true" styleClass="card-text"/>
                    </VBox>
                    <VBox fx:id="ingredientRowsContainer" spacing="12.0"/>
                    <Button text="Zutat hinzufügen" onAction="#addIngredientRow"
                            maxWidth="1.7976931348623157E308" styleClass="secondary-button"/>
                </VBox>

                <VBox spacing="16.0" styleClass="content-card, form-section-card">
                    <Label text="Geschmacksrichtung" styleClass="card-title"/>
                    <Label text="Wähle mindestens eine Geschmacksrichtung aus."
                           wrapText="true" styleClass="card-text"/>
                    <FlowPane fx:id="tasteOptionsContainer" hgap="12.0" vgap="10.0"/>
                    <HBox spacing="12.0">
                        <TextField fx:id="newTasteField"
                                   promptText="Neue Geschmacksrichtung"
                                   maxWidth="1.7976931348623157E308" HBox.hgrow="ALWAYS"/>
                        <Button text="Hinzufügen" onAction="#addTaste"
                                styleClass="secondary-button"/>
                    </HBox>
                </VBox>

                <VBox spacing="12.0" styleClass="content-card, form-section-card">
                    <VBox spacing="4.0">
                        <Label text="Nährwerte pro Portion" styleClass="card-title"/>
                        <Label text="Optional: Angaben gelten immer für eine Portion."
                               wrapText="true" styleClass="card-text"/>
                    </VBox>
                    <HBox spacing="18.0">
                        <VBox spacing="6.0" HBox.hgrow="ALWAYS" styleClass="form-field">
                            <Label text="Kalorien (kcal)" styleClass="form-label"/>
                            <TextField fx:id="caloriesField" promptText="z. B. 650"
                                       maxWidth="1.7976931348623157E308"/>
                        </VBox>
                        <VBox spacing="6.0" HBox.hgrow="ALWAYS" styleClass="form-field">
                            <Label text="Protein (g)" styleClass="form-label"/>
                            <TextField fx:id="proteinField" promptText="z. B. 42"
                                       maxWidth="1.7976931348623157E308"/>
                        </VBox>
                    </HBox>
                    <HBox spacing="18.0">
                        <VBox spacing="6.0" HBox.hgrow="ALWAYS" styleClass="form-field">
                            <Label text="Kohlenhydrate (g)" styleClass="form-label"/>
                            <TextField fx:id="carbohydratesField" promptText="z. B. 71,5"
                                       maxWidth="1.7976931348623157E308"/>
                        </VBox>
                        <VBox spacing="6.0" HBox.hgrow="ALWAYS" styleClass="form-field">
                            <Label text="Fett (g)" styleClass="form-label"/>
                            <TextField fx:id="fatField" promptText="z. B. 18"
                                       maxWidth="1.7976931348623157E308"/>
                        </VBox>
                    </HBox>
                </VBox>

                <VBox spacing="16.0" styleClass="content-card, form-section-card">
                    <HBox alignment="CENTER_LEFT" spacing="12.0">
                        <VBox spacing="4.0">
                            <Label text="Zubereitung" styleClass="card-title"/>
                            <Label text="Optional: Hinzugefügte Schritte werden automatisch nummeriert."
                                   wrapText="true" styleClass="card-text"/>
                        </VBox>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Button text="Schritt hinzufügen" onAction="#addStepRow"
                                styleClass="secondary-button"/>
                    </HBox>
                    <VBox fx:id="stepRowsContainer" spacing="12.0"/>
                </VBox>

                <HBox alignment="CENTER_RIGHT" spacing="12.0" styleClass="form-actions">
                    <Button text="Abbrechen" onAction="#cancel" styleClass="secondary-button"/>
                    <Button fx:id="saveButton" text="Speichern" onAction="#saveRecipe"
                            styleClass="primary-button"/>
                </HBox>
            </VBox>
        </StackPane>
    </content>
</ScrollPane>
