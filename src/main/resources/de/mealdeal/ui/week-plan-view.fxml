<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<ScrollPane xmlns:fx="http://javafx.com/fxml/1" fitToWidth="true" hbarPolicy="NEVER"
            styleClass="content-scroll">
    <content>
        <StackPane alignment="TOP_CENTER" styleClass="page-shell">
            <VBox maxWidth="1080.0" spacing="28.0" styleClass="page-container">
                <VBox spacing="6.0" styleClass="page-header">
                    <Label text="Wochenplan" styleClass="page-title"/>
                    <Label text="Plane deine Woche von Montag bis Sonntag."
                           wrapText="true" styleClass="page-subtitle"/>
                </VBox>
                <VBox maxWidth="1.7976931348623157E308" spacing="14.0" styleClass="card, wide-card">
                    <Label text="Deine Woche" styleClass="card-title"/>
                    <FlowPane hgap="10.0" vgap="10.0">
                        <Label text="Montag" styleClass="day-chip"/>
                        <Label text="Dienstag" styleClass="day-chip"/>
                        <Label text="Mittwoch" styleClass="day-chip"/>
                        <Label text="Donnerstag" styleClass="day-chip"/>
                        <Label text="Freitag" styleClass="day-chip"/>
                        <Label text="Samstag" styleClass="day-chip"/>
                        <Label text="Sonntag" styleClass="day-chip"/>
                    </FlowPane>
                </VBox>
            </VBox>
        </StackPane>
    </content>
</ScrollPane>
