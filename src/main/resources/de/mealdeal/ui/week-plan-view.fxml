<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.VBox?>

<ScrollPane xmlns:fx="http://javafx.com/fxml/1" fitToWidth="true" hbarPolicy="NEVER"
            styleClass="content-scroll">
    <content>
        <VBox spacing="12.0" styleClass="page">
            <padding>
                <Insets top="44.0" right="44.0" bottom="44.0" left="44.0"/>
            </padding>
            <Label text="Wochenplan" styleClass="page-title"/>
            <Label text="Montag bis Sonntag" wrapText="true" styleClass="page-subtitle"/>
            <VBox spacing="14.0" styleClass="placeholder-box">
                <Label text="Deine Woche" styleClass="section-title"/>
                <FlowPane hgap="10.0" vgap="10.0">
                    <Label text="Montag" styleClass="day-chip"/>
                    <Label text="Dienstag" styleClass="day-chip"/>
                    <Label text="Mittwoch" styleClass="day-chip"/>
                    <Label text="Donnerstag" styleClass="day-chip"/>
                    <Label text="Freitag" styleClass="day-chip"/>
                    <Label text="Samstag" styleClass="day-chip"/>
                    <Label text="Sonntag" styleClass="day-chip"/>
                </FlowPane>
            </VBox>
        </VBox>
    </content>
</ScrollPane>
