<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<ScrollPane xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="de.mealdeal.ui.controller.WeekPlanController"
            fitToWidth="true" hbarPolicy="NEVER"
            styleClass="content-scroll">
    <content>
        <StackPane alignment="TOP_CENTER" styleClass="page-shell">
            <VBox maxWidth="1080.0" spacing="28.0" styleClass="page-container">
                <VBox spacing="6.0" styleClass="page-header">
                    <Label text="Wochenplan" styleClass="page-title"/>
                    <Label text="Plane deine Woche von Montag bis Sonntag."
                           wrapText="true" styleClass="page-subtitle"/>
                    <Label fx:id="weekRangeLabel" styleClass="meal-plan-week-range"/>
                </VBox>

                <VBox fx:id="dayCardsContainer" maxWidth="1.7976931348623157E308"
                      spacing="16.0" styleClass="meal-plan-days"/>

                <VBox fx:id="errorState" alignment="CENTER" managed="false" visible="false"
                      maxWidth="1.7976931348623157E308" spacing="12.0"
                      styleClass="card, recipe-state-card, error-state-card">
                    <Label text="Wochenplan konnte nicht geladen werden." styleClass="card-title"/>
                    <Label fx:id="errorMessage" wrapText="true" styleClass="card-text"/>
                    <Button text="Erneut versuchen" onAction="#refresh"
                            styleClass="secondary-button"/>
                </VBox>
            </VBox>
        </StackPane>
    </content>
</ScrollPane>
