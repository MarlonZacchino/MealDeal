<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="de.mealdeal.ui.controller.WeekPlanController"
           styleClass="week-plan-root">
    <ScrollPane fitToWidth="true" hbarPolicy="NEVER"
                styleClass="content-scroll">
        <content>
            <StackPane alignment="TOP_CENTER" styleClass="page-shell">
                <VBox maxWidth="1.7976931348623157E308" spacing="28.0"
                      styleClass="page-container, week-plan-page-container">
                    <VBox spacing="6.0" styleClass="page-header">
                        <Label text="Wochenplan" styleClass="page-title"/>
                        <Label text="Plane deine Woche von Montag bis Sonntag."
                               wrapText="true" styleClass="page-subtitle"/>
                        <Label fx:id="weekRangeLabel" styleClass="meal-plan-week-range"/>
                    </VBox>

                    <VBox fx:id="dayCardsContainer" maxWidth="1.7976931348623157E308"
                          spacing="16.0" styleClass="meal-plan-days"/>

                    <VBox fx:id="errorState" alignment="CENTER" managed="false" visible="false"
                          maxWidth="1.7976931348623157E308" spacing="12.0"
                          styleClass="card, recipe-state-card, error-state-card">
                        <Label text="Wochenplan konnte nicht geladen werden." styleClass="card-title"/>
                        <Label fx:id="errorMessage" wrapText="true" styleClass="card-text"/>
                        <Button text="Erneut versuchen" onAction="#refresh"
                                styleClass="secondary-button"/>
                    </VBox>

                    <Region minHeight="110.0"/>
                </VBox>
            </StackPane>
        </content>
    </ScrollPane>

    <Label fx:id="saveChangesMessage" managed="false" visible="false"
           maxWidth="360.0" wrapText="true"
           StackPane.alignment="BOTTOM_RIGHT"
           styleClass="meal-plan-save-message">
        <StackPane.margin>
            <Insets top="0.0" right="20.0" bottom="76.0" left="0.0"/>
        </StackPane.margin>
    </Label>

    <Button fx:id="saveChangesButton" text="Änderungen speichern"
            onAction="#saveChanges" StackPane.alignment="BOTTOM_RIGHT"
            styleClass="primary-button, meal-plan-save-button">
        <StackPane.margin>
            <Insets top="0.0" right="20.0" bottom="20.0" left="0.0"/>
        </StackPane.margin>
    </Button>
</StackPane>
