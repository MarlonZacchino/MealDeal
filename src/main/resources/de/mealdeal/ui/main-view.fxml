<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns:fx="http://javafx.com/fxml/1"
            fx:id="rootShell"
            fx:controller="de.mealdeal.ui.controller.MainController"
            stylesheets="@styles.css"
            styleClass="root-shell">
    <left>
        <VBox maxWidth="1.7976931348623157E308" spacing="6.0" styleClass="sidebar">
            <padding>
                <Insets top="28.0" right="18.0" bottom="22.0" left="18.0"/>
            </padding>
            <Label text="MealDeal" styleClass="sidebar-title"/>
            <Label text="Essen einfach planen." wrapText="true" styleClass="sidebar-subtitle"/>
            <VBox spacing="4.0" styleClass="navigation-list">
                <Button fx:id="homeButton" text="Start" maxWidth="1.7976931348623157E308"
                        onAction="#showHome" styleClass="nav-button"/>
                <Button fx:id="recipesButton" text="Gerichte" maxWidth="1.7976931348623157E308"
                        onAction="#showRecipes" styleClass="nav-button"/>
                <Button fx:id="searchButton" text="Gericht finden" maxWidth="1.7976931348623157E308"
                        onAction="#showSearch" styleClass="nav-button"/>
                <Button fx:id="weekPlanButton" text="Wochenplan" maxWidth="1.7976931348623157E308"
                        onAction="#showWeekPlan" styleClass="nav-button"/>
                <Button fx:id="ingredientsButton" text="Zutaten" maxWidth="1.7976931348623157E308"
                        onAction="#showIngredients" styleClass="nav-button"/>
                <Button fx:id="inventoryButton" text="Inventar" maxWidth="1.7976931348623157E308"
                        onAction="#showInventory" styleClass="nav-button"/>
                <Button fx:id="shoppingButton" text="Einkaufsliste" maxWidth="1.7976931348623157E308"
                        onAction="#showShopping" styleClass="nav-button"/>
            </VBox>
            <Region VBox.vgrow="ALWAYS"/>
            <ToggleButton fx:id="themeToggle" text="Light Mode"
                          maxWidth="1.7976931348623157E308"
                          onAction="#toggleTheme" styleClass="theme-toggle"/>
        </VBox>
    </left>
    <center>
        <StackPane fx:id="contentHost" alignment="TOP_CENTER" styleClass="content-host"/>
    </center>
</BorderPane>
