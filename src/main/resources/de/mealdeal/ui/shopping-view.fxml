<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<ScrollPane xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="de.mealdeal.ui.controller.ShoppingListController"
            fitToWidth="true" hbarPolicy="NEVER"
            styleClass="content-scroll">
    <content>
        <StackPane alignment="TOP_CENTER" styleClass="page-shell">
            <VBox maxWidth="1.7976931348623157E308" spacing="28.0" styleClass="page-container">
                <VBox spacing="6.0" styleClass="page-header">
                    <Label text="Einkaufsliste" styleClass="page-title"/>
                    <Label text="Bereite deinen Einkauf für heute oder die Woche vor."
                           wrapText="true" styleClass="page-subtitle"/>
                </VBox>
                <VBox maxWidth="1.7976931348623157E308" spacing="16.0"
                      styleClass="content-card, shopping-mode-card">
                    <HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="shopping-mode-switch">
                        <ToggleButton fx:id="todayMode" text="Heute" selected="true"
                                      onAction="#showToday" styleClass="shopping-mode-button"/>
                        <ToggleButton fx:id="weekMode" text="Woche"
                                      onAction="#showCurrentWeek" styleClass="shopping-mode-button"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label fx:id="itemCountLabel" managed="false" visible="false"
                               styleClass="selection-count"/>
                    </HBox>
                    <HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="shopping-mode-switch">
                        <ToggleButton fx:id="withoutInventoryMode" text="Ohne Inventar"
                                      onAction="#showWithoutInventory"
                                      styleClass="shopping-mode-button"/>
                        <ToggleButton fx:id="withInventoryMode" text="Mit Inventar"
                                      selected="true" onAction="#showWithInventory"
                                      styleClass="shopping-mode-button"/>
                    </HBox>
                    <Label fx:id="modeDescription" wrapText="true" styleClass="card-text"/>
                </VBox>

                <VBox maxWidth="1.7976931348623157E308" spacing="14.0"
                      styleClass="content-card, shopping-results-card">
                    <VBox fx:id="itemsContainer" managed="false" visible="false" spacing="8.0"/>

                    <VBox fx:id="emptyState" alignment="CENTER" spacing="8.0"
                          styleClass="shopping-state">
                        <Label fx:id="emptyTitle" text="Für heute ist nichts einzukaufen."
                               styleClass="card-title"/>
                        <Label fx:id="emptyMessage"
                               text="Plane für heute ein Gericht, damit hier die Zutaten erscheinen."
                               textAlignment="CENTER" wrapText="true" styleClass="card-text"/>
                    </VBox>

                    <VBox fx:id="errorState" alignment="CENTER" managed="false" visible="false"
                          spacing="10.0" styleClass="shopping-state, error-state-card">
                        <Label text="Einkaufsliste konnte nicht geladen werden."
                               styleClass="card-title"/>
                        <Label fx:id="errorMessage" textAlignment="CENTER"
                               wrapText="true" styleClass="card-text"/>
                        <Button text="Erneut versuchen" onAction="#refresh"
                                styleClass="secondary-button"/>
                    </VBox>
                </VBox>
            </VBox>
        </StackPane>
    </content>
</ScrollPane>
