<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<ScrollPane xmlns:fx="http://javafx.com/fxml/1" fitToWidth="true" hbarPolicy="NEVER"
            styleClass="content-scroll">
    <content>
        <StackPane alignment="TOP_CENTER" styleClass="page-shell">
            <VBox maxWidth="1080.0" spacing="28.0" styleClass="page-container">
                <VBox spacing="6.0" styleClass="page-header">
                    <Label text="Einkaufsliste" styleClass="page-title"/>
                    <Label text="Bereite deinen Einkauf für heute oder die Woche vor."
                           wrapText="true" styleClass="page-subtitle"/>
                </VBox>
                <VBox maxWidth="1.7976931348623157E308" spacing="12.0" styleClass="card, wide-card">
                    <Label text="Heute" styleClass="card-title"/>
                    <Label text="Die Zutaten für die heute geplanten Gerichte."
                           wrapText="true" styleClass="card-text"/>
                </VBox>
                <VBox maxWidth="1.7976931348623157E308" spacing="12.0" styleClass="card, wide-card">
                    <Label text="Diese Woche" styleClass="card-title"/>
                    <Label text="Alle noch benötigten Zutaten bis Sonntag."
                           wrapText="true" styleClass="card-text"/>
                </VBox>
            </VBox>
        </StackPane>
    </content>
</ScrollPane>
