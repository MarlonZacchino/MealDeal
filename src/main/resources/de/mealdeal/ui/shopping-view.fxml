<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.VBox?>

<ScrollPane xmlns:fx="http://javafx.com/fxml/1" fitToWidth="true" hbarPolicy="NEVER"
            styleClass="content-scroll">
    <content>
        <VBox spacing="12.0" styleClass="page">
            <padding>
                <Insets top="44.0" right="44.0" bottom="44.0" left="44.0"/>
            </padding>
            <Label text="Einkaufsliste" styleClass="page-title"/>
            <Label text="Hier entstehen künftig Einkaufslisten aus deinem Wochenplan."
                   wrapText="true" styleClass="page-subtitle"/>
            <FlowPane hgap="20.0" vgap="20.0" prefWrapLength="620.0" styleClass="card-grid">
                <VBox prefWidth="280.0" minHeight="150.0" spacing="12.0" styleClass="action-card">
                    <Label text="Heute" styleClass="card-title"/>
                    <Label text="Die Zutaten für die heute geplanten Gerichte."
                           wrapText="true" styleClass="card-text"/>
                </VBox>
                <VBox prefWidth="280.0" minHeight="150.0" spacing="12.0" styleClass="action-card">
                    <Label text="Diese Woche" styleClass="card-title"/>
                    <Label text="Alle noch benötigten Zutaten bis Sonntag."
                           wrapText="true" styleClass="card-text"/>
                </VBox>
            </FlowPane>
        </VBox>
    </content>
</ScrollPane>
