<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<ScrollPane xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="de.mealdeal.ui.controller.RecipesController"
            fitToWidth="true" hbarPolicy="NEVER" styleClass="content-scroll">
    <content>
        <StackPane alignment="TOP_CENTER" styleClass="page-shell">
            <VBox maxWidth="1080.0" spacing="28.0" styleClass="page-container">
                <HBox alignment="CENTER_LEFT" spacing="20.0" styleClass="page-header">
                    <VBox spacing="6.0">
                        <Label text="Gerichte" styleClass="page-title"/>
                        <Label text="Verwalte deine gespeicherten Gerichte."
                               wrapText="true" styleClass="page-subtitle"/>
                    </VBox>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button text="Neues Gericht" onAction="#openCreateRecipe"
                            styleClass="primary-button"/>
                </HBox>

                <VBox fx:id="recipeListContainer" managed="false" visible="false"
                      maxWidth="1.7976931348623157E308" spacing="12.0"
                      styleClass="recipe-list"/>

                <VBox fx:id="emptyState" alignment="CENTER" maxWidth="1.7976931348623157E308"
                      spacing="12.0" styleClass="card, recipe-state-card">
                    <Label text="Noch keine Gerichte gespeichert." styleClass="card-title"/>
                    <Label text="Sobald du dein erstes Gericht anlegst, erscheint es hier."
                           wrapText="true" styleClass="card-text"/>
                    <Button text="Erstes Gericht hinzufügen" onAction="#openCreateRecipe"
                            styleClass="primary-button"/>
                </VBox>

                <VBox fx:id="errorState" alignment="CENTER" managed="false" visible="false"
                      maxWidth="1.7976931348623157E308" spacing="12.0"
                      styleClass="card, recipe-state-card, error-state-card">
                    <Label text="Gerichte konnten nicht geladen werden." styleClass="card-title"/>
                    <Label fx:id="errorMessage" wrapText="true" styleClass="card-text"/>
                    <Button text="Erneut versuchen" onAction="#refresh"
                            styleClass="secondary-button"/>
                </VBox>
            </VBox>
        </StackPane>
    </content>
</ScrollPane>
