<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.TitledPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<ScrollPane xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="de.mealdeal.ui.controller.InventoryController"
            fitToWidth="true" hbarPolicy="NEVER" styleClass="content-scroll">
    <content>
        <StackPane alignment="TOP_CENTER" styleClass="page-shell">
            <VBox maxWidth="1.7976931348623157E308" spacing="28.0" styleClass="page-container">
                <VBox spacing="6.0" styleClass="page-header">
                    <Label text="Inventar" styleClass="page-title"/>
                    <Label text="Verwalte deine vorhandenen Zutaten und Mengen."
                           wrapText="true" styleClass="page-subtitle"/>
                </VBox>

                <VBox maxWidth="1.7976931348623157E308" spacing="14.0"
                      styleClass="card, wide-card, inventory-add-card">
                    <Label text="Bestand hinzufügen" styleClass="card-title"/>
                    <FlowPane hgap="12.0" vgap="10.0" alignment="CENTER_LEFT">
                        <ComboBox fx:id="ingredientBox" promptText="Zutat auswählen"
                                  maxWidth="1.7976931348623157E308"
                                  styleClass="inventory-ingredient-picker"/>
                        <TextField fx:id="quantityField" promptText="Menge, z. B. 500"
                                   styleClass="inventory-quantity-input"/>
                        <ComboBox fx:id="unitBox" promptText="Einheit"
                                  styleClass="inventory-unit-picker"/>
                        <Button text="Hinzufügen" onAction="#addItem"
                                styleClass="primary-button"/>
                    </FlowPane>
                    <Label fx:id="formError" managed="false" visible="false"
                           wrapText="true" styleClass="form-error"/>
                </VBox>

                <TitledPane fx:id="categoryManagementSection"
                            text="Zutatenkategorien verwalten"
                            collapsible="true" expanded="false"
                            maxWidth="1.7976931348623157E308"
                            styleClass="search-options-pane, inventory-category-management">
                    <content>
                        <VBox spacing="14.0" styleClass="inventory-category-management-content">
                            <Label text="Kategorien" styleClass="card-title"/>
                            <Label text="Lege Kategorien an, benenne sie um oder ändere ihre Reihenfolge. Sonstiges bleibt als geschützter Fallback erhalten."
                                   wrapText="true" styleClass="card-text"/>
                            <FlowPane alignment="CENTER_LEFT" hgap="10.0" vgap="10.0">
                                <TextField fx:id="categoryNameField"
                                           promptText="Neue Kategorie"
                                           styleClass="inventory-category-name-input"/>
                                <Button text="Kategorie hinzufügen" onAction="#addCategory"
                                        styleClass="primary-button"/>
                            </FlowPane>
                            <Label fx:id="categoryFormError" managed="false" visible="false"
                                   wrapText="true" styleClass="form-error"/>
                            <VBox fx:id="categoryManagementContainer" spacing="8.0"/>
                        </VBox>
                    </content>
                </TitledPane>

                <TitledPane fx:id="ingredientManagementSection"
                            text="Zentrale Zutaten bearbeiten"
                            collapsible="true" expanded="false"
                            maxWidth="1.7976931348623157E308"
                            styleClass="search-options-pane, inventory-ingredient-management">
                    <content>
                        <VBox spacing="14.0" styleClass="inventory-category-management-content">
                            <Label text="Zutaten" styleClass="card-title"/>
                            <Label text="Ändere Name oder Kategorie. Rezepte und Inventareinträge behalten dieselbe zentrale Zutat."
                                   wrapText="true" styleClass="card-text"/>
                            <Label fx:id="ingredientManagementError" managed="false"
                                   visible="false" wrapText="true" styleClass="form-error"/>
                            <VBox fx:id="ingredientManagementContainer" spacing="8.0"/>
                        </VBox>
                    </content>
                </TitledPane>

                <VBox fx:id="categoryContainer" spacing="16.0"/>

                <VBox fx:id="emptyState" alignment="CENTER" spacing="8.0"
                      styleClass="card, inventory-state">
                    <Label text="Noch kein Inventar erfasst." styleClass="card-title"/>
                    <Label text="Füge oben deinen ersten vorhandenen Bestand hinzu."
                           textAlignment="CENTER" wrapText="true" styleClass="card-text"/>
                </VBox>

                <VBox fx:id="loadErrorState" alignment="CENTER" managed="false" visible="false"
                      spacing="10.0" styleClass="card, inventory-state, error-state-card">
                    <Label text="Inventar konnte nicht geladen werden." styleClass="card-title"/>
                    <Label fx:id="loadErrorMessage" textAlignment="CENTER"
                           wrapText="true" styleClass="card-text"/>
                    <Button text="Erneut versuchen" onAction="#refresh"
                            styleClass="secondary-button"/>
                </VBox>
            </VBox>
        </StackPane>
    </content>
</ScrollPane>
